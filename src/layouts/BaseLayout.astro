---
interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const currentPath = Astro.url.pathname;
const pageTitle = title === 'About' ? 'Oscar Frias' : `${title} | Oscar Frias`;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);

const navigation = [
  { label: 'About', href: '/' },
  { label: 'Work', href: '/projects/' },
  { label: 'Writing', href: '/writing/' },
  { label: 'Experience', href: '/resume/' },
];

const isCurrent = (href: string) => href === '/' ? currentPath === href : currentPath.startsWith(href);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content="website" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="wordmark" href="/" aria-label="Oscar Frias, home">
        <span>Oscar</span>
        <strong>Frias</strong>
      </a>
      <p class="site-discipline">Mechanical engineer<br />&amp; technical lead</p>
      <nav aria-label="Main navigation">
        <ul>
          {navigation.map(({ label, href }) => (
            <li>
              <a href={href} aria-current={isCurrent(href) ? 'page' : undefined}>
                {label}
              </a>
            </li>
          ))}
          <li>
            <a href="https://kc1zty.github.io/" target="_blank" rel="noreferrer">
              Amateur Radio <span aria-hidden="true">↗</span>
            </a>
          </li>
        </ul>
      </nav>
    </header>

    <main>
      <p class="eyebrow">{title}</p>
      <slot />
    </main>

    <footer>
      <span class="footer-mark">OF—{new Date().getFullYear()}</span>
      <span>Somerville, Massachusetts</span>
      <span class="footer-links">
        <a href="mailto:oscar.friasg@gmail.com">Email</a>
        <a href="https://www.linkedin.com/in/oscarfrias/en">LinkedIn ↗</a>
      </span>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light;
    font-family: "IBM Plex Sans", "Helvetica Neue", Helvetica, Arial, sans-serif;
    color: #17212a;
    background: #ffffff;
    font-synthesis: none;
    --ink: #17212a;
    --paper: #ffffff;
    --signal: #d74721;
    --muted: #687077;
    --rule: #c9cdd0;
  }

  * {
    box-sizing: border-box;
  }

  body {
    min-height: 100vh;
    max-width: 90rem;
    margin: 0 auto;
    padding: 0 clamp(1.25rem, 4vw, 4rem);
    display: grid;
    grid-template-rows: auto 1fr auto;
    background: var(--paper);
  }

  a {
    color: inherit;
  }

  .site-header {
    min-height: 8rem;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: clamp(1.5rem, 4vw, 4rem);
    border-bottom: 2px solid var(--ink);
  }

  .wordmark {
    display: flex;
    align-items: baseline;
    color: var(--ink);
    font-size: 1.25rem;
    font-weight: 400;
    letter-spacing: -0.045em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .wordmark strong {
    margin-left: 0.22em;
    color: var(--signal);
    font-weight: 850;
  }

  .site-discipline {
    margin: 0;
    padding-left: 1rem;
    border-left: 1px solid var(--rule);
    color: var(--muted);
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    line-height: 1.45;
    text-transform: uppercase;
  }

  nav ul {
    margin: 0;
    padding: 0;
    display: flex;
    align-items: center;
    gap: 1.6rem;
    list-style: none;
  }

  nav a {
    padding: 0.65rem 0;
    color: var(--ink);
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-decoration: none;
    text-transform: uppercase;
  }

  nav a:hover,
  nav a[aria-current="page"] {
    color: var(--signal);
  }

  nav a[aria-current="page"] {
    border-bottom: 3px solid currentColor;
  }

  main {
    width: min(100%, 72rem);
    padding: clamp(4rem, 9vw, 8rem) 0 clamp(5rem, 11vw, 10rem);
  }

  .eyebrow {
    margin: 0 0 2.5rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: var(--signal);
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .eyebrow::before {
    content: "";
    width: 2.5rem;
    height: 3px;
    background: currentColor;
  }

  h1 {
    max-width: 15ch;
    margin: 0;
    font-family: "Arial Narrow", "Helvetica Neue", Arial, sans-serif;
    font-size: clamp(3.2rem, 8.5vw, 7.6rem);
    font-stretch: condensed;
    font-weight: 850;
    letter-spacing: -0.075em;
    line-height: 0.82;
    text-transform: uppercase;
  }

  .intro {
    max-width: 46rem;
    margin: 2.5rem 0 0;
    color: #3e484f;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(1.18rem, 2.2vw, 1.55rem);
    line-height: 1.55;
  }

  footer {
    min-height: 7rem;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
    border-top: 2px solid var(--ink);
    color: var(--muted);
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .footer-mark { color: var(--ink); font-weight: 700; }

  .footer-links {
    display: flex;
    justify-content: flex-end;
    gap: 1rem;
  }

  .footer-links a {
    text-underline-offset: 0.2em;
  }

  @media (max-width: 48rem) {
    body {
      padding: 0 1.25rem;
    }

    .site-header {
      padding: 1.25rem 0;
      align-items: flex-start;
      grid-template-columns: 1fr auto;
    }

    .site-discipline { display: none; }

    nav ul {
      justify-content: flex-end;
      flex-wrap: wrap;
      gap: 0.5rem 1.1rem;
    }

    main {
      padding: 5rem 0;
    }
  }

  @media (max-width: 30rem) {
    .site-header {
      display: grid;
    }

    nav ul {
      justify-content: flex-start;
    }

    footer {
      align-items: flex-start;
      grid-template-columns: 1fr;
      padding: 1.5rem 0;
    }

    .footer-links { justify-content: flex-start; }
  }
</style>